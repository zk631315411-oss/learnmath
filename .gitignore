# 教材 PDF 是外部资产（约 440MB），不进 git
data/textbooks/*.pdf
frontend/public/*.pdf

# 依赖与构建产物
node_modules/
dist/
venv/
__pycache__/
*.pyc

# 前端构建/测试产物：tsbuildinfo 是 tsc 增量缓存、test-results 是 e2e 运行结果，均不入库
frontend/tsconfig.tsbuildinfo
frontend/test-results/

# 环境变量（密钥不入库）
.env

# 日志与临时文件
*.log
tmp/
data/*.pre-consolidation-*.db

# One-click deployment runtime and large offline assets
deploy/runtime.env
deploy/assets/installers/
deploy/assets/images/
deploy/runtime/
release/

# DSH 平台插件源码/运行态与本地调试脚本：与 LearnMath 产品无关，仅本机使用，不入库
.agent-teams/
.claude/
dsh-agent-teams/
dsh-agent-teams-command/
dsh-agent-teams-provider/
research/
patch-log.mjs
test-meeting-command.mjs
verify-log.mjs
.tmp-qa/
data/learning.db
