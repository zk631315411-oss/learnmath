# JWT 签名密钥：生产环境必须换成强随机值（python-jose 签名用）
JWT_SECRET=your_jwt_secret_here

# QA 文字回答用 LLM（OpenAI 兼容协议）
QA_LLM_API_KEY=your_qa_api_key_here
QA_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QA_LLM_MODEL=qwen3.6-plus

# 公式转写默认复用上面的 QA_LLM_*；只有使用独立模型时才填写。
FORMULA_API_KEY=
FORMULA_API_BASE=
FORMULA_MODEL=
FORMULA_CONVERSION_TIMEOUT_SECONDS=8
FORMULA_CONVERSION_TOTAL_TIMEOUT_SECONDS=15

# 公式截图/手写识别视觉 provider（默认智谱 OpenAI 兼容接口）。
# 模型可用性、费用和限流以部署时的 provider 控制台为准。
FORMULA_VISION_API_KEY=
FORMULA_VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4
FORMULA_VISION_MODEL=glm-4.1v-thinking-flash
FORMULA_VISION_THINKING=disabled
FORMULA_VISION_TIMEOUT_SECONDS=25

# 可选的独立兜底 provider；代码不会自动复用视觉 key。
FORMULA_FALLBACK_API_KEY=
FORMULA_FALLBACK_API_BASE=
FORMULA_FALLBACK_MODEL=
FORMULA_FALLBACK_TIMEOUT_SECONDS=5
FORMULA_RECOGNIZE_TOTAL_TIMEOUT_SECONDS=30
FORMULA_CONTENT_VISION_TIMEOUT_SECONDS=30

# Phase 3 learner model is enabled by default in production.
LEARNER_MODEL_ENABLED=true
LEARNER_MODEL_DEBUG=false
APP_ENV=development

# Neo4j Aura knowledge graph
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_aura_password_here
NEO4J_DATABASE=neo4j

# 截图问答用 VL 多模态模型
QA_VL_MODEL=qwen3-vl-plus

# SQLite 数据库文件路径（留空 = 默认 <项目根>/data/learning.db，可用绝对路径覆盖以便隔离测试）
AI_MATH_DB_PATH=

# Manim asynchronous artifact rendering
MANIM_REDIS_URL=redis://127.0.0.1:6379/0
MANIM_QUEUE=learnmath-manim
MANIM_MAX_QUEUE=2
MANIM_MAX_DURATION_SECONDS=30
MANIM_RENDER_TIMEOUT_SECONDS=90
MANIM_MAX_OUTPUT_BYTES=26214400
